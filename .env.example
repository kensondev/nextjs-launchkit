# Public canonical origin. Use your deployed HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# console | webhook | resend
# Console mode needs no keys. It logs email addresses and does not store a durable list.
WAITLIST_PROVIDER=console

# Required only for webhook mode. Use HTTPS in production.
# The endpoint receives POST JSON: { "email": "person@example.com" }
WAITLIST_WEBHOOK_URL=

# Required only for resend mode. Keep both values server-side.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
